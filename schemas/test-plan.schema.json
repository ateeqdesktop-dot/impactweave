{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ateeqdesktop-dot/impactweave/releases/download/v0.3.0/test-plan.schema.json",
  "title": "ImpactWeave test plan manifest",
  "type": "object",
  "required": ["tests"],
  "properties": {
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/testTarget"}
    },
    "test_observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/testObservation"}
    },
    "test_policy": {"$ref": "#/$defs/testPolicy"}
  },
  "$defs": {
    "testTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_.:/@-]+$", "maxLength": 160},
        "command": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string"}},
        "paths": {"type": "array", "maxItems": 256, "items": {"type": "string"}},
        "tags": {"type": "array", "maxItems": 32, "items": {"type": "string"}},
        "always": {"type": "boolean", "default": false},
        "estimated_seconds": {"type": "integer", "minimum": 0, "maximum": 86400, "default": 0}
      }
    },
    "testObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_id", "paths", "source", "observed_at"],
      "properties": {
        "test_id": {"type": "string", "maxLength": 160},
        "paths": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"type": "string"}},
        "source": {"type": "string", "minLength": 1, "maxLength": 128},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "testPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tracked_paths": {"type": "array", "maxItems": 256, "items": {"type": "string"}},
        "ignored_paths": {"type": "array", "maxItems": 256, "items": {"type": "string"}},
        "fallback_on_unknown": {"type": "boolean", "default": true},
        "max_selected": {"type": "integer", "minimum": 1, "maximum": 100000, "default": 512},
        "stale_after_days": {"type": "integer", "minimum": 1, "maximum": 3650, "default": 30}
      }
    }
  }
}
